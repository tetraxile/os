# INSTRUCTION STRUCTURE
# bytes   | name
# --------+------------
# 0-4     | prefix
# 1-3     | opcode
# 0-1     | ModR/M byte
# 0-1     | SIB byte
# 0/1/2/4 | displacement
# 0/1/2/4 | immediate data

# OPCODE BIT FIELDS
# 
# for some instructions, the lowest two bits of the primary opcode
# are meaningful:
# 
# 7 6 5 4 3 2|1|0
# opcode bits|D|W
# 
# direction (D):
#     0 = ModR/M <- reg
#     1 = reg <- ModR/M
# 
# operand size (W):
#     0 = 8-bit
#     1 = 32-bit (16-bit with 0x66 prefix)

# ModR/M BYTE - mod(2):reg(3):r/m(3)
# 
# mod = addressing mode:
#     00 - [r/m] or 101 (disp32)
#     01 - [r/m + disp8]
#     10 - [r/m + disp32]
#     11 - r/m
# reg = register OR opcode modifier (for certain opcodes)
# r/m = r/m field
# 
#     |                 MOD
# r/m |  00   |    01    |     10    |      11
#-----+-------+----------+-----------+---------------
# 000 | [eax] | [eax+d8] | [eax+d32] | al / ax / eax
# 001 | [ecx] | [ecx+d8] | [ecx+d32] | cl / cx / ecx
# 010 | [edx] | [edx+d8] | [edx+d32] | dl / dx / edx
# 011 | [ebx] | [ebx+d8] | [ebx+d32] | bl / bx / ebx
# 100 | [SIB]*| [SIB+d8]*| [SIB+d32]*| ah / sp / esp
# 101 | [d32]*| [ebp+d8] | [ebp+d32] | ch / bp / ebp
# 110 | [esi] | [esi+d8] | [esi+d32] | dh / si / esi
# 111 | [edi] | [edi+d8] | [edi+d32] | bh / di / edi
#   (exceptions marked with *)
# 
# example:
#     mov ebx, eax     # 89 c3    - [c3 = 11 000 011]
#     inc byte [eax]   # fe 00    - [00 = 00 000 000]
#     dec byte [eax]   # fe 08    - [08 = 00 001 000]
#     mov ebx, ebp     # 89 eb    - [eb = 11 101 011]
#     mov [eax]+4, ebx # 89 58 04 - [58 = 01 011 000]

# SIB BYTE - scale(2):index(3):base(3)
# 
# value = scale * index + base
# 
# bits | scale | index | base
#------+-------+-------+------
# 000  |   1   |  eax  | eax
# 001  |   2   |  ecx  | ecx
# 010  |   4   |  edx  | edx
# 011  |   8   |  ebx  | ebx
# 100  |   -   |   0   | esp
# 101  |   -   |  ebp  |  ?
# 110  |   -   |  esi  | esi
# 111  |   -   |  edi  | edi

# REGISTER INDICES
# 0 - 000 - eax / ax / al
# 1 - 001 - ecx / cx / cl
# 2 - 010 - edx / dx / dl
# 3 - 011 - ebx / bx / bl
# 4 - 100 - esp / sp / ah
# 5 - 101 - ebp / bp / ch
# 6 - 110 - esi / si / dh
# 7 - 111 - edi / di / bh

# OPCODES
# 
# info:
#   prefixes in uppercase
#   instruction aliases in (parentheses)
#   other necessary info in [brackets]
# 
# opcode syntax:
#   XX/# = ModR/M byte with operation number #
#   XX/r = opcode is XX + register index
#   rm = ModR/M byte
#   ?? = necessary byte (e.g. for immediates)
# 
# assembly syntax:
#   r8, r16, r32 = register
#   r/m8, r/m16, r/m32 = register or memory address
#   imm8, imm16, imm32 = immediate value
#   rel8, rel32 = address relative to the byte following instruction
#   m16:16, m16:32 = far pointer
#   m = 
# 
# 
#    00   rm              add r/m8, r8
#    01   rm              add r/m32, r32
# 66 01   rm              add r/m16, r16
#    02   rm              add r8, r/m8
#    03   rm              add r32, r/m32
# 66 03   rm              add r16, r/m16
#    04   ??              add al, imm8
#    05   ?? ?? ?? ??     add eax, imm32
# 66 05   ?? ??           add ax, imm16
#    08   rm              or  r/m8, r8
#    09   rm              or  r/m32, r32
# 66 09   rm              or  r/m16, r16
#    0a   rm              or  r8, r/m8
#    0b   rm              or  r32, r/m32
# 66 0b   rm              or  r16, r/m16
#    0c   ??              or  al, imm8
#    0d   ?? ?? ?? ??     or  eax, imm32
# 66 0d   ?? ??           or  ax, imm16
# 0f                      TWO-BYTE INSTRUCTION
#    10   rm              adc r/m8, r8
#    11   rm              adc r/m32, r32
# 66 11   rm              adc r/m16, r16
#    12   rm              adc r8, r/m8
#    13   rm              adc r32, r/m32
# 66 13   rm              adc r16, r/m16
#    14   ??              adc al, imm8
#    15   ?? ?? ?? ??     adc eax, imm32
# 66 15   ?? ??           adc ax, imm16
#    18   rm              sbb r/m8, r8
#    19   rm              sbb r/m32, r32
# 66 19   rm              sbb r/m16, r16
#    1a   rm              sbb r8, r/m8
#    1b   rm              sbb r32, r/m32
# 66 1b   rm              sbb r16, r/m16
#    1c   ??              sbb al, imm8
#    1d   ?? ?? ?? ??     sbb eax, imm32
# 66 1d   ?? ??           sbb ax, imm16
#    20   rm              and r/m8, r8
#    21   rm              and r/m32, r32
# 66 21   rm              and r/m16, r16
#    22   rm              and r8, r/m8
#    23   rm              and r32, r/m32
# 66 23   rm              and r16, r/m16
#    24   ??              and al, imm8
#    25   ?? ?? ?? ??     and eax, imm32
# 66 25   ?? ??           and ax, imm16
#    28   rm              sub r/m8, r8
#    29   rm              sub r/m32, r32
# 66 29   rm              sub r/m16, r16
#    2a   rm              sub r8, r/m8
#    2b   rm              sub r32, r/m32
# 66 2b   rm              sub r16, r/m16
#    2c   ??              sub al, imm8
#    2d   ?? ?? ?? ??     sub eax, imm32
# 66 2d   ?? ??           sub ax, imm16
#    30   rm              xor r/m8, r8
#    31   rm              xor r/m32, r32
# 66 31   rm              xor r/m16, r16
#    32   rm              xor r8, r/m8
#    33   rm              xor r32, r/m32
# 66 33   rm              xor r16, r/m16
#    34   ??              xor al, imm8
#    35   ?? ?? ?? ??     xor eax, imm32
# 66 35   ?? ??           xor ax, imm16
#    38   rm              cmp r/m8, r8
#    39   rm              cmp r/m32, r32
# 66 39   rm              cmp r/m16, r16
#    3a   rm              cmp r8, r/m8
#    3b   rm              cmp r32, r/m32
# 66 3b   rm              cmp r16, r/m16
#    3c   ??              cmp al, imm8
#    3d   ?? ?? ?? ??     cmp eax, imm32
# 66 3d   ?? ??           cmp ax, imm16
#    40+r                 inc r32
# 66 40+r                 inc r16
#    48+r                 dec r32
# 66 48+r                 dec r16
#    50+r                 push r32
# 66 50+r                 push r16
#    58+r                 pop r32
# 66 58+r                 pop r16
#    60                   pushad
# 66 60                   pusha
#    61                   popad
# 66 61                   popa
#    68   ?? ?? ?? ??     push imm32
# 66 68   ?? ??           push imm16
#    69   rm ?? ?? ?? ??  imul r32, r/m32, imm32
# 66 69   rm ?? ??        imul r16, r/m16, imm16
#    6a   ??              push imm8
#    6b   rm ??           imul r8, r/m8, imm8
#    6c                   insb
#    6d                   insd
# 66 6d                   insw
#    6e                   outsb
#    6f                   outsd
# 66 6f                   outsw
#    70   ??              jo rel8
#    71   ??              jno rel8
#    72   ??              jb rel8 (jnae, jc)
#    73   ??              jnb rel8 (jae, jnc)
#    74   ??              jz rel8 (je)
#    75   ??              jnz rel8 (jne)
#    76   ??              jbe rel8 (jna)
#    77   ??              jnbe rel8 (ja)
#    78   ??              js rel8
#    79   ??              jns rel8
#    7a   ??              jp rel8 (jpe)
#    7b   ??              jnp rel8 (jpo)
#    7c   ??              jl rel8 (jnge)
#    7d   ??              jge rel8 (jnl)
#    7e   ??              jle rel8 (jng)
#    7f   ??              jg rel8 (jnle)
#    80/0 rm ??           add r/m8, imm8
#    80/1 rm ??           or  r/m8, imm8
#    80/2 rm ??           adc r/m8, imm8
#    80/3 rm ??           sbb r/m8, imm8
#    80/4 rm ??           and r/m8, imm8
#    80/5 rm ??           sub r/m8, imm8
#    80/6 rm ??           xor r/m8, imm8
#    80/7 rm ??           cmp r/m8, imm8
#    81/0 rm ?? ?? ?? ??  add r/m32, imm32
#    81/1 rm ?? ?? ?? ??  or  r/m32, imm32
#    81/2 rm ?? ?? ?? ??  adc r/m32, imm32
#    81/3 rm ?? ?? ?? ??  sbb r/m32, imm32
#    81/4 rm ?? ?? ?? ??  and r/m32, imm32
#    81/5 rm ?? ?? ?? ??  sub r/m32, imm32
#    81/6 rm ?? ?? ?? ??  xor r/m32, imm32
#    81/7 rm ?? ?? ?? ??  cmp r/m32, imm32
# 66 81/0 rm ?? ??        add r/m16, imm16
# 66 81/1 rm ?? ??        or  r/m16, imm16
# 66 81/2 rm ?? ??        adc r/m16, imm16
# 66 81/3 rm ?? ??        sbb r/m16, imm16
# 66 81/4 rm ?? ??        and r/m16, imm16
# 66 81/5 rm ?? ??        sub r/m16, imm16
# 66 81/6 rm ?? ??        xor r/m16, imm16
# 66 81/7 rm ?? ??        cmp r/m16, imm16
#    82   rm ??           alias for 80
#    83/0 rm ??           add r/m32, imm8
#    83/1 rm ??           or  r/m32, imm8
#    83/2 rm ??           adc r/m32, imm8
#    83/3 rm ??           sbb r/m32, imm8
#    83/4 rm ??           and r/m32, imm8
#    83/5 rm ??           sub r/m32, imm8
#    83/6 rm ??           xor r/m32, imm8
#    83/7 rm ??           cmp r/m32, imm8
# 66 83/0 rm ??           add r/m16, imm8
# 66 83/1 rm ??           or  r/m16, imm8
# 66 83/2 rm ??           adc r/m16, imm8
# 66 83/3 rm ??           sbb r/m16, imm8
# 66 83/4 rm ??           and r/m16, imm8
# 66 83/5 rm ??           sub r/m16, imm8
# 66 83/6 rm ??           xor r/m16, imm8
# 66 83/7 rm ??           cmp r/m16, imm8
#    84   rm              test r/m8, r8
#    85   rm              test r/m32, r32
# 66 85   rm              test r/m16, r16
#    86   rm              xchg r8, r/m8
#    87   rm              xchg r32, r/m32
# 66 87   rm              xchg r16, r/m16
#    88   rm              mov r/m8, r8
#    89   rm              mov r/m32, r32
# 66 89   rm              mov r/m16, r16
#    8a   rm              mov r8, r/m8
#    8b   rm              mov r32, r/m32
# 66 8b   rm              mov r16, r/m16
#    8d   rm              lea r32, m
# 66 8d   rm              lea r16, m
#    90+r                 xchg r32, eax
# 66 90+r                 xchg r16, ax
#    90                   nop
#    a0   ?? ?? ?? ??     mov al, moffs8
#    a1   ?? ?? ?? ??     mov eax, moffs32
# 66 a1   ?? ?? ?? ??     mov ax, moffs16
#    a2   ?? ?? ?? ??     mov moffs8, al
#    a3   ?? ?? ?? ??     mov moffs32, eax
# 66 a3   ?? ?? ?? ??     mov moffs16, eax
#    a4                   movsb [di, si]
#    a5                   movsd [di, si]
# 66 a5                   movsw [di, si]
#    a6                   cmpsb [di, si]
#    a7                   cmpsd [di, si]
# 66 a7                   cmpsw [di, si]
#    a8   ??              test al, imm8
#    a9   ?? ?? ?? ??     test eax, imm32
# 66 a9   ?? ??           test ax, imm16
#    aa                   stosb [di, al]
#    ab                   stosd [di, eax]
# 66 ab                   stosw [di, ax]
#    ac                   lodsb [al, si]
#    ad                   lodsd [ax, si]
# 66 ad                   lodsw [eax, si]
#    ae                   scasb [di, al]
#    af                   scasd [di, eax]
# 66 af                   scasw [di, ax]
#    b0+r ??              mov r8, imm8
#    b8+r ?? ?? ?? ??     mov r32, imm32
# 66 b8+r ?? ??           mov r16, imm16
