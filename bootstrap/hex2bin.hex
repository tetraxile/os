8a 45 1a          # 00f8 | mov al, byte [ebp+0x1a]    - Arbeitsbyte lesen [01 000 101 -> 45]
88 07             # 00fb | mov byte [edi], al         - Byte zum Ausgabepuffer schreiben [00 000 111 -> 07]
47                # 00fd | inc edi                    - out_cursor erhöhen
c6 45 1a 00       # 00fe | mov byte [ebp+0x1a], 0     - Arbeitsbyte löschen [01 000 101 -> 45]
c6 45 19 08       # 0102 | mov byte [ebp+0x19], 8     - Verschiebungsbetrag zurücksetzen [01 000 101 -> 45]
eb b0             # 0106 | jmp .loop                  - weiterlesen
                  # 
                  # 0108 | .comment:
c6 45 18 01       # 0108 | mov byte [ebp+0x18], 1     - Ignorieren anfangen [01 000 101 -> 45]
eb aa             # 010c | jmp .loop                  - weiterlesen
                  # 
                  # 010e | .newline:
c6 45 18 00       # 010e | mov byte [ebp+0x18], 0     - Ignorieren beenden [01 000 101 -> 45]
eb a4             # 0112 | jmp .loop                  - weiterlesen
                  # 
