                  # 
8b 5d 00          # 0098 | mov ebx, [ebp+0]           - dd = Eingabedatei [01 011 101 -> 5d]
89 e1             # 009b | mov ecx, esp               - Zeiger auf Eingabepuffer [11 100 001 -> e1]
8b 55 10          # 009d | mov edx, [ebp+0x10]        - Größe der Eingabedatei [01 010 101 -> 55] 
b8 03 00 00 00    # 00a0 | mov eax, 3                 - read Systemaufruf
cd 80             # 00a5 | int 0x80                   - Systemaufruf
                  # 
85 c0             # 00a7 | test eax, eax              - wenn Rückgabewert < 0 [11 000 000 -> c0]
0f 88 b9 00 00 00 # 00a9 | js read_error              - dann goto read_error
                  # 
89 e6             # 00af | mov esi, esp               - esi = Anfang der Eingabedatei [11 100 110 -> e6]
89 e7             # 00b1 | mov edi, esp               - edi = Anfang der Ausgabedatei [11 100 111 -> e7]
89 f2             # 00b3 | mov edx, esi               -   [11 110 010 -> f2]
03 55 10          # 00b5 | add edx, [ebp+0x10]        - edx = Ende der Eingabedatei [01 010 101 -> 55]
                  # 
                  # 00b8 | .loop:
39 d6             # 00b8 | cmp esi, edx               - wenn in_cursor >= Ende der Eingabedatei [11 010 110 -> d6]
7d 58             # 00ba | jge .end                   - dann verlasse Loop
                  # 
8a 06             # 00bc | mov al, [esi]              - Zeichen lesen [00 000 110 -> 06]
46                # 00be | inc esi                    - Cursor erhöhen
                  # 
3c 0a             # 00bf | cmp al, 0xa                - wenn Zeichen == '\n'
74 4b             # 00c1 | je .newline                - dann Ignorieren beenden und weiterlesen
                  # 
80 7d 18 01       # 00c3 | cmp byte [ebp+0x18], 1     - wenn in einem Kommentar [01 111 101 -> 7d]
74 ef             # 00c7 | je .loop                   - dann weiterlesen
                  # 
3c 23             # 00c9 | cmp al, 0x23               - wenn Zeichen == ';'
74 3b             # 00cb | je .comment                - dann bis Newline ignorieren
                  # 
3c 30             # 00cd | cmp al, 0x30               - wenn Zeichen < '0'
7c e7             # 00cf | jl .loop                   - dann weiterlesen
                  # 
3c 39             # 00d1 | cmp al, 0x39               - wenn Zeichen <= '9'
7e 0c             # 00d3 | jle .digit                 - dann als Nummer parsen
                  # 
3c 61             # 00d5 | cmp al, 0x61               - wenn Zeichen < 'a'
7c df             # 00d7 | jl .loop                   - dann weiterlesen
                  # 
3c 66             # 00d9 | cmp al, 0x66               - wenn Zeichen > 'f'
7f db             # 00db | jnle .loop                 - dann weiterlesen, sonst als Buchstabe parsen
                  # 
                  # 00dd | .letter:
2c 57             # 00dd | sub al, 0x57               - Zeichen als Buchstabe parsen
eb 02             # 00df | jmp .add_nibble            - Nibble anhängen
                  # 
                  # 00e1 | .digit:
2c 30             # 00e1 | sub al, 0x30               - Zeichen als Nummer parsen
                  # 
                  # 00e3 | .add_nibble:
8a 4d 19          # 00e3 | mov cl, byte [ebp+0x19]    - Verschiebungsbetrag lesen [01 001 101 -> 4d]
80 e9 04          # 00e6 | sub cl, 4                  -   [11 101 001 -> e9]
d2 e0             # 00e9 | shl al, cl                 - AL in Nibble schieben [11 100 000 -> e0]
08 45 1a          # 00eb | or byte [ebp+0x1a], al     - AL zum Arbeitsbyte addieren [01 000 101 -> 45]
80 6d 19 04       # 00ee | sub byte [ebp+0x19], 4     - Nibble-Index verringern [01 101 101 -> 6d]
80 7d 19 00       # 00f2 | cmp byte [ebp+0x19], 0     - wenn Nibble-Index == 0 [01 111 101 -> 7d]
7f c0             # 00f6 | jge .loop                  - dann weiterlesen, sonst Byte kopieren
                  # 
