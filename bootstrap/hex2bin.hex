# Dateilayout:
#   8048054-8048246: Code
#   8048300-8048340: fstat-Puffer
#   8048300+: Ausgabepuffer
#   8048300+: Inhalt der Eingabedatei

# Stacklayout:
#   00 | 04 | in_dd
#   04 | 04 | out_dd
#   08 | 04 | in_path
#   0c | 04 | out_path
#   10 | 04 | in_size
#   14 | 04 | out_size
#   18 | 01 | is_ignoring
#   19 | 01 | nibble_idx
#   1a | 01 | nibbles


# =================== ELF-HEADER ===================

7f 45 4c 46  # 0000 | magische Zahl: \x7fELF
01           # 0004 | Datei-Klasse: 32-Bit = 1
   01        # 0005 | Datenkodierung: Little-Endian = 1
      01     # 0006 | Datei-Version: aktuell = 1
         00  # 0007 | OS-/ABI-Identifizierung: System-V = 0
00           # 0008 | ABI-Version = 0 auf Linux
   00 00 00  # 0009 | 
00 00 00 00  # 000c | 
02 00        # 0010 | ELF-Typ: ausführbare Datei = 2
      03 00  # 0012 | Prozessor-Typ: 386 = 3
01 00 00 00  # 0014 | ELF-Version: aktuell = 1
54 80 04 08  # 0018 | Entry Point: Ladeadresse (x86) = 0x8048000
34 00 00 00  # 001c | Programm-Header-Offset: direkt nach dem ELF-Header = 0x34
00 00 00 00  # 0020 | Section-Header-Offset: kein Section-Header = 0
00 00 00 00  # 0024 | prozessorspezifische Flags
34 00        # 0028 | Größe des ELF-Headers = 0x34
      20 00  # 002a | Größe eines Programm-Header-Eintrags = 0x20
01 00        # 002c | Anzahl der Programm-Headers = 1
      28 00  # 002e | Größe eines Section-Header-Eintrags = 0x28
00 00        # 0030 | Anzahl der Section-Headers = 0
      00 00  # 0032 | Index der Section-Header-Stringtabelle = 0


# =================== PROGRAM-HEADER ===================

01 00 00 00  # 0034 | Segment-Typ: PT_LOAD = 1
00 00 00 00  # 0038 | Segment-Offset = 0
00 80 04 08  # 003c | virtuelle Adresse des Segments = Ladeadresse
00 00 00 00  # 0040 | physische Adresses des Segments (irrelevant auf Linux) = 0
46 02 00 00  # 0044 | Größe des Segments in der Datei
00 00 10 00  # 0048 | Größe des Segments im Speicher (1MB)
07 00 00 00  # 004c | Flags: 1=X, 2=W, 4=R
00 10 00 00  # 0050 | Alignment: 0x1000


# =================== CODE ===================

                  # Präambel
89 e5             # 0054 | mov ebp, esp               - anfängliches Stack-Pointer speichern [11 100 101 -> e5]
fc                # 0056 | cld                        - Richtung-Flag löschen (+)
bc 00 83 04 08    # 0057 | mov esp, 0x08048300        - Puffer-Pointer setzen
c7 45 18          # 005c | mov byte [ebp+0x18],       - Verschiebungsbetrag und Ignorieren-Flag initialisieren 
      00 08 00 00 # 005f |               0x00080000   -   [01 000 101 -> 45]
                  # 
83 7d 00 03       # 0063 | cmp dword [ebp], 3         - wenn argc != 3 [01 111 101 -> 7d]
0f 85 07 01 00 00 # 0067 | jne args_error             - dann goto args_error
                  # 
8b 5d 08          # 006d | mov ebx, [ebp+8]           - Zeiger auf Pfadname [01 011 101 -> 5d]
31 c9             # 0070 | xor ecx, ecx               - Schalter: read-only (0) [11 001 001 -> c9]
31 d2             # 0072 | xor edx, edx               - Modus (keiner bei read-only) [11 010 010 -> d2]
b8 05 00 00 00    # 0074 | mov eax, 5                 - open Systemaufruf
cd 80             # 0079 | int 0x80                   - Systemaufruf
                  # 
85 c0             # 007b | test eax, eax              - wenn Rückgabewert < 0 [11 000 000 -> c0]
0f 88 d9 00 00 00 # 007d | jl file_error              - dann goto file_error
                  # 
89 45 00          # 0083 | mov [ebp+0], eax           - Eingabedatei-Handle speichern [01 000 101 -> 45]
                  # 
89 c3             # 0086 | mov ebx, eax               - dd = Eingabedatei [11 000 011 -> c3]
89 e1             # 0088 | mov ecx, esp               - Zeiger auf Statuspuffer [11 100 001 -> e1]
b8 6c 00 00 00    # 008a | mov eax, 0x6c              - fstat Systemaufruf
cd 80             # 008f | int 0x80                   - Systemaufruf
                  # 
8b 44 24 14       # 0091 | mov eax, [esp+0x14]        - Dateigröße holen [01 000 100]
